<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sp="using:ScottPlot.Avalonia"
             xmlns:c="using:Gw2Gizmos.Desktop.Controls"
             x:Class="Gw2Gizmos.Desktop.Controls.PriceHistoryChart">
    <!-- DataContext: the shared PriceHistoryViewModel. A detail chart over a short navigator; the hover readout floats
         over the detail chart. -->
    <Grid RowDefinitions="*,70">
        <Panel Grid.Row="0">
            <sp:AvaPlot Name="DetailPlot" />
            <Canvas Name="ReadoutLayer" IsHitTestVisible="False">
                <Border Name="Readout" IsVisible="False" Padding="8,4" CornerRadius="4" Canvas.Top="4"
                        Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <!-- Time, then buy and sell (coin icons, or "—" for an empty side) and volume. -->
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <StackPanel.Styles>
                            <Style Selector="TextBlock">
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                            <Style Selector="c|CoinDisplay">
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="IconSize" Value="11" />
                            </Style>
                        </StackPanel.Styles>
                        <TextBlock Name="ReadoutTime" Margin="0,0,10,0" />
                        <TextBlock Text="Buy" />
                        <c:CoinDisplay Name="ReadoutBuy" />
                        <TextBlock Name="ReadoutBuyNone" Text="—" />
                        <TextBlock Text="Sell" Margin="10,0,0,0" />
                        <c:CoinDisplay Name="ReadoutSell" />
                        <TextBlock Name="ReadoutSellNone" Text="—" />
                        <TextBlock Name="ReadoutVolume" Margin="10,0,0,0" />
                    </StackPanel>
                </Border>
            </Canvas>
        </Panel>
        <sp:AvaPlot Grid.Row="1" Name="NavigatorPlot" Cursor="Hand" />
    </Grid>
</UserControl>
