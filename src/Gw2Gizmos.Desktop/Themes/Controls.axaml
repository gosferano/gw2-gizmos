<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="using:FluentAvalonia.UI.Controls"
                    xmlns:c="using:Gw2Gizmos.Desktop.Controls"
                    xmlns:core="using:Gw2Gizmos.Desktop.Core"
                    xmlns:conv="using:Gw2Gizmos.Desktop.Converters">

    <!-- Shared height for form controls (inputs + buttons) so they line up on a row. -->
    <x:Double x:Key="FormControlHeight">38</x:Double>

    <!-- Monospace for API keys: the first installed of these (Windows, then common Linux/macOS fonts). -->
    <FontFamily x:Key="MonospaceFontFamily">Cascadia Mono, Consolas, JetBrains Mono, DejaVu Sans Mono, Liberation Mono, Menlo, monospace</FontFamily>

    <conv:ProfessionBrushConverter x:Key="ProfessionBrush" />

    <!-- A character row on the Characters page: a stripe in the profession's colour and the profession (or elite
         specialization) icon on the left, who the character is, how much it's been played, and its crafting
         disciplines (inactive ones dimmed). -->
    <DataTemplate x:Key="CharacterRowTemplate" x:DataType="core:CharacterCard">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
            <Border Grid.Column="0" Width="4" CornerRadius="2" Margin="0,0,12,0"
                    Background="{Binding Profession, Converter={StaticResource ProfessionBrush}}" />
            <c:IconImage Grid.Column="1" IconUrl="{Binding ProfessionIconUrl}" Width="36" Height="36"
                         VerticalAlignment="Center" Margin="0,0,12,0" />
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Summary}" FontSize="12" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="4" Width="190" VerticalAlignment="Center" Margin="16,0,0,0">
                <TextBlock Text="{Binding PlayStats}" FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{Binding CreatedText}" FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <!-- Fixed width, kept even when empty, so the crafting and stats line up from row to row. -->
            <ItemsControl ItemsSource="{Binding Crafting}" Grid.Column="3" Width="230" Margin="12,0,0,0" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="core:CharacterCraftingLevel">
                            <Border CornerRadius="4" Padding="6,1" Margin="0,2,4,2" Opacity="{Binding Opacity}"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                <TextBlock Text="{Binding Label}" FontSize="12" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
        </Grid>
    </DataTemplate>

    <!-- The character page's header: the same identity on the left, then the stats spread across as label/value
         columns, so it stays about two lines tall. -->
    <DataTemplate x:Key="CharacterHeaderTemplate" x:DataType="core:CharacterCard">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto">
            <Grid.Styles>
                <Style Selector="TextBlock.label">
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                </Style>
                <Style Selector="StackPanel.stat">
                    <Setter Property="Margin" Value="24,0,0,0" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
            </Grid.Styles>
            <Border Grid.Column="0" Width="4" CornerRadius="2" Margin="0,0,12,0"
                    Background="{Binding Profession, Converter={StaticResource ProfessionBrush}}" />
            <c:IconImage Grid.Column="1" IconUrl="{Binding ProfessionIconUrl}" Width="48" Height="48"
                         VerticalAlignment="Center" Margin="0,0,12,0" />
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Summary}" FontSize="12" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="3" Classes="stat" IsVisible="{Binding HasCrafting}">
                <TextBlock Classes="label" Text="Crafting" />
                <ItemsControl ItemsSource="{Binding Crafting}" IsVisible="{Binding HasCrafting}" MaxWidth="240">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="core:CharacterCraftingLevel">
                            <Border CornerRadius="4" Padding="6,1" Margin="0,2,4,2" Opacity="{Binding Opacity}"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                <TextBlock Text="{Binding Label}" FontSize="12" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <StackPanel Grid.Column="4" Classes="stat">
                <TextBlock Classes="label" Text="Played" />
                <TextBlock Text="{Binding PlayedText}" />
            </StackPanel>
            <StackPanel Grid.Column="5" Classes="stat">
                <TextBlock Classes="label" Text="Deaths" />
                <TextBlock Text="{Binding DeathsText}" />
            </StackPanel>
            <StackPanel Grid.Column="6" Classes="stat">
                <TextBlock Classes="label" Text="Created" />
                <TextBlock Text="{Binding CreatedDate}" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!-- A bank/shared-inventory slot, or a placeholder when empty. The cell is square (SquareCell) inside a 10-column
         UniformGrid → exactly 10 per row with equal spacing on both axes. -->
    <DataTemplate x:Key="SlotTemplate" x:DataType="core:SlotRow">
        <!-- Empty slots have no name, so their (otherwise blank) tooltip is disabled. -->
        <c:SquareCell ToolTip.Tip="{Binding Name}" ToolTip.ServiceEnabled="{Binding !IsEmpty}">
            <Panel>
                <!-- Placeholder tile, always drawn: an empty slot shows it alone, and a filled slot whose item hasn't
                     synced yet (icon not downloaded) still reads as occupied — with its known count — instead of a
                     blank gap. The icon paints over the tile once it's available. -->
                <Border Margin="5" CornerRadius="6" BorderThickness="1"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource ControlElevationBorderBrush}" />
                <c:ItemImage ItemId="{Binding ItemId}" CornerRadius="6" Stretch="Uniform" Margin="5"
                             IsVisible="{Binding !IsEmpty}" />
                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,6"
                        Background="#CC000000" CornerRadius="4" Padding="4,0" IsVisible="{Binding HasCount}">
                    <TextBlock Text="{Binding CountDisplay}" FontSize="11" Foreground="White" />
                </Border>
            </Panel>
        </c:SquareCell>
    </DataTemplate>

    <!-- A material-storage cell: like a slot, but the count is always shown (0 included) and a held-none material
         is greyed out. -->
    <DataTemplate x:Key="MaterialCellTemplate" x:DataType="core:SlotRow">
        <c:SquareCell ToolTip.Tip="{Binding Name}">
            <Panel>
                <Border Margin="5" CornerRadius="6" BorderThickness="1"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource ControlElevationBorderBrush}" />
                <c:ItemImage ItemId="{Binding ItemId}" CornerRadius="6" Stretch="Uniform" Margin="5"
                             Desaturate="{Binding IsZero}" />
                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,6"
                        Background="#CC000000" CornerRadius="4" Padding="4,0">
                    <TextBlock Text="{Binding CountDisplay}" FontSize="11" Foreground="White" />
                </Border>
            </Panel>
        </c:SquareCell>
    </DataTemplate>

    <!-- A session "hoarded" currency row — wallet-row sized, hover highlight; DeltaDisplay is the signed gain/loss. -->
    <!-- A map played in a session/segment and the time on it — styled like the currency rows below. -->
    <DataTemplate x:Key="SessionMapRowTemplate" x:DataType="core:MapTimeRow">
        <Border Classes="hover-row">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" FontWeight="Medium" VerticalAlignment="Center"
                           Text="{Binding TimeDisplay}" />
                <c:FluentIcon Symbol="Map24" FontSize="20" Width="28" Margin="0,0,10,0" VerticalAlignment="Center"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </DockPanel>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="SessionCurrencyRowTemplate" x:DataType="core:SessionLootCurrency">
        <Border Classes="hover-row">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" FontWeight="Medium" VerticalAlignment="Center"
                           Text="{Binding DeltaDisplay}" />
                <c:IconImage IconUrl="{Binding IconUrl}" Width="28" Height="28" Margin="0,0,10,0"
                             VerticalAlignment="Center" />
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </DockPanel>
        </Border>
    </DataTemplate>

    <!-- A session "hoarded" item row — matches the currency row; the instant-sell gold value is the headline with
         the quantity below it. -->
    <DataTemplate x:Key="SessionItemRowTemplate" x:DataType="core:SessionLootItem">
        <Border Classes="hover-row">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right"
                            Margin="10,0,0,0">
                    <c:CoinDisplay Copper="{Binding ValueCopper}" Signed="True" FontWeight="Medium"
                                   HorizontalAlignment="Right" IsVisible="{Binding HasValue}" />
                    <TextBlock Text="{Binding DeltaDisplay}" FontSize="12" HorizontalAlignment="Right"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <c:ItemImage ItemId="{Binding ItemId}" Width="28" Height="28" Margin="0,0,10,0"
                             CornerRadius="4" Stretch="Uniform" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </DockPanel>
        </Border>
    </DataTemplate>

    <!-- Fluent card (WPF-UI's Card). -->
    <ControlTheme x:Key="{x:Type c:Card}" TargetType="c:Card">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- Win11-Settings-style page chrome: a pinned title/breadcrumb over a width-capped, centered body. Scrollable
         bodies scroll under the header; fixed ones (grids) fill the height and scroll internally. -->
    <ControlTheme x:Key="{x:Type c:PageShell}" TargetType="c:PageShell">
        <Setter Property="Template">
            <ControlTemplate>
                <Grid RowDefinitions="Auto,*">
                    <!-- Pinned breadcrumb header (every page; multi-level + clickable for sub-pages). -->
                    <c:CenteredContent Grid.Row="0" MaxContentWidth="{TemplateBinding MaxContentWidth}"
                                       Margin="36,18,36,8">
                        <!-- Crumbs render BreadcrumbEntry.ToString() (its Title) at FluentAvalonia's default size:
                             parents dimmer (full on hover), the current crumb at full colour. -->
                        <ui:FABreadcrumbBar Name="PART_Breadcrumb"
                                            ItemsSource="{TemplateBinding ResolvedBreadcrumbs}" />
                    </c:CenteredContent>

                    <!-- Body: scrolls for content pages, fills for grids (:fixed). -->
                    <ScrollViewer Name="PART_BodyScroll" Grid.Row="1"
                                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <c:CenteredContent MaxContentWidth="{TemplateBinding MaxContentWidth}" Margin="36,4,36,24">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </c:CenteredContent>
                    </ScrollViewer>
                </Grid>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:fixed /template/ ScrollViewer#PART_BodyScroll">
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
