<Project Sdk="Microsoft.NET.Sdk">

  <!-- The cross-platform desktop app (Linux and Windows): an Avalonia + FluentAvalonia head over the shared
       Gw2Gizmos.Desktop.Core. Replaces the deprecated WPF app (Gw2Gizmos.Desktop.Legacy). -->

  <!-- Which platform this build is for: the runtime identifier when one is given (`-r win-x64` / `-r linux-x64`, so
       either can be cross-built), otherwise the OS building it. A Windows build targets the Windows TFM (its platform
       library needs the WinRT toast API) and compiles with the WINDOWS symbol. -->
  <PropertyGroup>
    <Gw2GizmosWindows Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier.StartsWith('win'))</Gw2GizmosWindows>
    <Gw2GizmosWindows Condition="'$(RuntimeIdentifier)' == ''">$([MSBuild]::IsOSPlatform('Windows'))</Gw2GizmosWindows>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Gw2GizmosWindows)' == 'true'">
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- User-facing brand name (Gw2Gizmos.exe / Gw2Gizmos); project stays Gw2Gizmos.Desktop. The same main exe and
         Velopack pack id as the WPF app it replaces, so existing Windows installs update straight onto it. -->
    <AssemblyName>Gw2Gizmos</AssemblyName>
    <ApplicationIcon>Assets\gw2gizmos.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- The desktop release version: the release workflow tags gw2gizmos-desktop-{this} and releases it when that
         tag is new. -->
    <Version>0.7.0-beta.1</Version>
    <!-- ItemImage desaturates icons by walking the bitmap's pixel buffer directly. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <!-- Items and Logs grids; its collection view also backs the shared IItemsView seam. -->
    <PackageReference Include="Avalonia.Controls.DataGrid" />
    <PackageReference Include="FluentAvaloniaUI" />
    <!-- Price-history charts (built on SkiaSharp 3, like Avalonia 12). -->
    <PackageReference Include="ScottPlot.Avalonia" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <!-- The UI-agnostic view-models, services and seams this head implements. -->
    <ProjectReference Include="..\Gw2Gizmos.Desktop.Core\Gw2Gizmos.Desktop.Core.csproj" />
    <!-- Composition root picks the concrete DB provider. -->
    <ProjectReference Include="..\Gw2Gizmos.Data.Provider.Sqlite\Gw2Gizmos.Data.Provider.Sqlite.csproj" />
    <!-- Build the worker CLI alongside, but don't reference its assembly — the app launches it as a separate
         process so its heavy ingestion can't stall the UI thread. -->
    <ProjectReference Include="..\Gw2Gizmos.Data.Worker.Cli\Gw2Gizmos.Data.Worker.Cli.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <!-- The platform services: notifications, launch at login, secret storage, and (Linux) the Proton MumbleLink
       bridge launcher / (Windows) the worker's kill-on-close job. -->
  <ItemGroup Condition="'$(Gw2GizmosWindows)' == 'true'">
    <ProjectReference Include="..\Gw2Gizmos.Desktop.Platform.Windows\Gw2Gizmos.Desktop.Platform.Windows.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(Gw2GizmosWindows)' != 'true'">
    <ProjectReference Include="..\Gw2Gizmos.Desktop.Platform.Linux\Gw2Gizmos.Desktop.Platform.Linux.csproj" />
  </ItemGroup>

  <!-- Linux: ship the MumbleLink bridge (a win-x64 single-file exe that runs inside the game's Wine prefix) next to
       the app, in mumblelink-bridge/. Re-published only when its sources change. Its RID is pinned: an app built
       with -r linux-x64 would otherwise pass that down. On Windows the worker reads the game's shared memory
       directly. -->
  <ItemGroup Condition="'$(Gw2GizmosWindows)' != 'true'">
    <_MumbleLinkBridgeInputs Include="..\Gw2Gizmos.MumbleLink.Bridge\**\*.cs;..\Gw2Gizmos.MumbleLink.Bridge\*.csproj"
                             Exclude="..\Gw2Gizmos.MumbleLink.Bridge\obj\**;..\Gw2Gizmos.MumbleLink.Bridge\bin\**" />
  </ItemGroup>
  <Target Name="PublishMumbleLinkBridge" AfterTargets="Build" Condition="'$(Gw2GizmosWindows)' != 'true'"
          Inputs="@(_MumbleLinkBridgeInputs)" Outputs="$(OutDir)mumblelink-bridge\Gw2Gizmos.MumbleLink.Bridge.exe">
    <MSBuild Projects="..\Gw2Gizmos.MumbleLink.Bridge\Gw2Gizmos.MumbleLink.Bridge.csproj" Targets="Restore;Publish"
             Properties="Configuration=Release;RuntimeIdentifier=win-x64;SelfContained=true;PublishDir=$([System.IO.Path]::GetFullPath('$(OutDir)mumblelink-bridge'))/" />
  </Target>

  <!-- Dev (run-from-bin): merge the worker CLI's build output into the app's output dir so the app can spawn it as
       a sibling executable, sharing the runtime + common dependencies. Same rules as the WPF app's CopyWorkerCli:
       only files the app doesn't already emit are copied (the app wins on shared assemblies), except the worker's
       own Gw2Gizmos.* assemblies and loader metadata (*.json), which are always refreshed so it never runs stale
       code; and never the worker's standalone-only appsettings*.json, whose relative connection string would
       hijack the database path both processes get from launch args. -->
  <Target Name="CopyWorkerCli" AfterTargets="Build" Condition="'$(RuntimeIdentifier)' == ''">
    <ItemGroup>
      <_WorkerCliFiles Include="..\Gw2Gizmos.Data.Worker.Cli\bin\$(Configuration)\net10.0\**\*"
                       Exclude="..\Gw2Gizmos.Data.Worker.Cli\bin\$(Configuration)\net10.0\appsettings*.json" />
      <_WorkerCliNew Include="@(_WorkerCliFiles)" Condition="!Exists('$(OutDir)%(RecursiveDir)%(Filename)%(Extension)')" />
      <_WorkerCliRefresh Include="@(_WorkerCliFiles)"
                         Condition="'%(Extension)' == '.json' or $([System.String]::Copy('%(Filename)').StartsWith('Gw2Gizmos.'))" />
      <_StaleWorkerAppsettings Include="$(OutDir)appsettings*.json" />
    </ItemGroup>
    <Delete Files="@(_StaleWorkerAppsettings)" />
    <Copy SourceFiles="@(_WorkerCliNew)" DestinationFiles="@(_WorkerCliNew->'$(OutDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_WorkerCliRefresh)" DestinationFiles="@(_WorkerCliRefresh->'$(OutDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <!-- Publish: stage the worker CLI's publish (matching the app's self-contained / RID settings), then merge it into
       the app's publish root, copying only files the app doesn't already emit (the app wins on shared assemblies). -->
  <Target Name="PublishWorkerCli" AfterTargets="Publish">
    <PropertyGroup>
      <_AppPublishFull Condition="$([System.IO.Path]::IsPathRooted('$(PublishDir)'))">$(PublishDir)</_AppPublishFull>
      <_AppPublishFull Condition="!$([System.IO.Path]::IsPathRooted('$(PublishDir)'))">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/$(PublishDir)'))/</_AppPublishFull>
      <_WorkerStage>$([System.IO.Path]::GetFullPath('$(IntermediateOutputPath)WorkerPublish'))/</_WorkerStage>
    </PropertyGroup>
    <MSBuild Projects="$(MSBuildThisFileDirectory)../Gw2Gizmos.Data.Worker.Cli/Gw2Gizmos.Data.Worker.Cli.csproj"
             Targets="Publish"
             Properties="Configuration=$(Configuration);PublishDir=$(_WorkerStage);SelfContained=$(SelfContained);RuntimeIdentifier=$(RuntimeIdentifier)" />
    <ItemGroup>
      <!-- The worker's appsettings*.json is standalone-only, never part of the app (see CopyWorkerCli). -->
      <_WorkerPublished Include="$(_WorkerStage)**/*" Exclude="$(_WorkerStage)appsettings*.json" />
      <_WorkerPublishedNew Include="@(_WorkerPublished)" Condition="!Exists('$(_AppPublishFull)%(RecursiveDir)%(Filename)%(Extension)')" />
    </ItemGroup>
    <Copy SourceFiles="@(_WorkerPublishedNew)" DestinationFiles="@(_WorkerPublishedNew->'$(_AppPublishFull)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <!-- The staging publish is a full self-contained copy, only needed for the worker's unique files; drop it. -->
    <RemoveDir Directories="$(_WorkerStage)" />
  </Target>

  <!-- Publish (Linux): the MumbleLink bridge the build placed in the output directory ships in the package too. -->
  <Target Name="PublishMumbleLinkBridgeFiles" AfterTargets="Publish" Condition="'$(Gw2GizmosWindows)' != 'true'">
    <ItemGroup>
      <_BridgeFiles Include="$(OutDir)mumblelink-bridge/*.exe" />
    </ItemGroup>
    <Copy SourceFiles="@(_BridgeFiles)" DestinationFolder="$(PublishDir)mumblelink-bridge" SkipUnchangedFiles="true" />
  </Target>

</Project>
