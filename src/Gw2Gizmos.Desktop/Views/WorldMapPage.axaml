<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Gw2Gizmos.Desktop.Controls"
             xmlns:core="using:Gw2Gizmos.Desktop.Core"
             x:Class="Gw2Gizmos.Desktop.Views.WorldMapPage"
             x:DataType="core:WorldMapViewModel">
    <c:PageShell Title="World map" Scrollable="False" MaxContentWidth="100000">
        <Border CornerRadius="8" ClipToBounds="True">
            <Panel>
                <c:MapView Continent="{Binding Continent}" CenterX="{Binding CenterX}" CenterY="{Binding CenterY}"
                           Zoom="{Binding Zoom}" MinZoom="{Binding MinZoom}" MaxZoom="{Binding MaxZoom}"
                           Landmarks="{Binding Landmarks}" CopyChatLinkCommand="{Binding CopyChatLinkCommand}"
                           Player="{Binding Player}" IsFollowing="{Binding IsFollowing}" Flight="{Binding Flight}" />

                <!-- What a click just copied, for a few seconds. -->
                <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="12" Padding="12,8"
                        CornerRadius="6" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        IsVisible="{Binding HasCopiedMessage}" IsHitTestVisible="False">
                    <TextBlock Text="{Binding CopiedMessage}" />
                </Border>

                <!-- Following the character, zoom and home, over the map's bottom-right corner. -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12" Padding="4"
                        CornerRadius="6" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="2">
                        <Button Theme="{StaticResource TransparentButton}" Padding="8" ToolTip.Tip="Centre on your character"
                                Command="{Binding FollowPlayerCommand}">
                            <c:FluentIcon Symbol="MyLocation24" FontSize="16" />
                        </Button>
                        <Button Theme="{StaticResource TransparentButton}" Padding="8" ToolTip.Tip="Zoom in"
                                Command="{Binding ZoomInCommand}">
                            <c:FluentIcon Symbol="ZoomIn24" FontSize="16" />
                        </Button>
                        <Button Theme="{StaticResource TransparentButton}" Padding="8" ToolTip.Tip="Zoom out"
                                Command="{Binding ZoomOutCommand}">
                            <c:FluentIcon Symbol="ZoomOut24" FontSize="16" />
                        </Button>
                        <Button Theme="{StaticResource TransparentButton}" Padding="8" ToolTip.Tip="Back to central Tyria"
                                Command="{Binding HomeCommand}">
                            <c:FluentIcon Symbol="Home24" FontSize="16" />
                        </Button>
                    </StackPanel>
                </Border>
            </Panel>
        </Border>
    </c:PageShell>
</UserControl>
