<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:c="using:Gw2Gizmos.Desktop.Controls"
             xmlns:core="using:Gw2Gizmos.Desktop.Core"
             x:Class="Gw2Gizmos.Desktop.Views.CharactersPage"
             x:DataType="core:CharactersViewModel">
    <c:PageShell Breadcrumbs="{Binding Breadcrumbs}">
        <StackPanel>
            <!-- No account picked yet -->
            <c:Card Margin="0,4,0,0" Padding="20" IsVisible="{Binding !HasAccount}">
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="No account selected. Add an API key and pick an account on the API keys page." />
            </c:Card>

            <StackPanel IsVisible="{Binding HasAccount}">
                <!-- Account selected but nothing synced yet -->
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,4,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           IsVisible="{Binding !HasCharacters}" />

                <!-- One row per character → its page. -->
                <ItemsControl ItemsSource="{Binding Characters}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="core:CharacterCard">
                            <Button Margin="0,0,0,8" Padding="12,10" HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Command="{Binding $parent[UserControl].((core:CharactersViewModel)DataContext).OpenCommand}"
                                    CommandParameter="{Binding Name}">
                                <DockPanel>
                                    <c:FluentIcon DockPanel.Dock="Right" Symbol="ChevronRight24" FontSize="16"
                                                  Margin="16,0,0,0" VerticalAlignment="Center"
                                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource CharacterRowTemplate}" />
                                </DockPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </c:PageShell>
</UserControl>
