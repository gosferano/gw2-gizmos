<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:c="using:Gw2Gizmos.Desktop.Controls"
             xmlns:core="using:Gw2Gizmos.Desktop.Core"
             x:Class="Gw2Gizmos.Desktop.Views.AccountPage"
             x:DataType="core:AccountViewModel">
    <c:PageShell Title="Account">
        <StackPanel>
            <!-- No account picked yet -->
            <c:Card Margin="0,4,0,0" Padding="20" IsVisible="{Binding !HasAccount}">
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="No account selected. Add an API key (with the account, wallet, inventories and tradingpost permissions) on the API keys page, then pick which account to view." />
            </c:Card>

            <StackPanel IsVisible="{Binding HasAccount}">
                <!-- Current account (the global selection), shown here instead of as a breadcrumb crumb. -->
                <TextBlock Text="{Binding AccountName}" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Summary}" ToolTip.Tip="{Binding SummaryTooltip}" Margin="0,2,0,14"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <!-- Per-section sub-pages for the selected account. -->
                <ui:FASettingsExpander Header="Value" Description="What the account is worth, over time"
                                       Margin="0,0,0,8" IconSource="{c:FluentIconSource DataTrending24}"
                                       IsClickEnabled="True" ActionIconSource="ChevronRight" Click="OnOpenValue" />
                <ui:FASettingsExpander Header="Characters" Description="Your characters, their builds and bags"
                                       Margin="0,0,0,8" IconSource="{c:FluentIconSource People24}"
                                       IsClickEnabled="True" ActionIconSource="ChevronRight" Click="OnOpenCharacters" />
                <ui:FASettingsExpander Header="Achievements" Description="Your progress, and quick wins"
                                       Margin="0,0,0,8" IconSource="{c:FluentIconSource Trophy24}"
                                       IsClickEnabled="True" ActionIconSource="ChevronRight"
                                       Click="OnOpenAchievements" />
                <ui:FASettingsExpander Header="Wallet" Description="Currencies and coin" Margin="0,0,0,8"
                                       IconSource="{c:FluentIconSource Wallet24}" IsClickEnabled="True"
                                       ActionIconSource="ChevronRight" Click="OnOpenWallet" />
                <ui:FASettingsExpander Header="Material storage" Description="Crafting materials by category"
                                       Margin="0,0,0,8" IconSource="{c:FluentIconSource BoxMultiple24}"
                                       IsClickEnabled="True" ActionIconSource="ChevronRight" Click="OnOpenMaterials" />
                <ui:FASettingsExpander Header="Bank" Description="Account bank contents" Margin="0,0,0,8"
                                       IconSource="{c:FluentIconSource BuildingBank24}" IsClickEnabled="True"
                                       ActionIconSource="ChevronRight" Click="OnOpenBank" />
                <ui:FASettingsExpander Header="Shared inventory" Description="Account-wide shared slots"
                                       Margin="0,0,0,8" IconSource="{c:FluentIconSource Backpack24}"
                                       IsClickEnabled="True" ActionIconSource="ChevronRight"
                                       Click="OnOpenSharedInventory" />
            </StackPanel>
        </StackPanel>
    </c:PageShell>
</UserControl>
