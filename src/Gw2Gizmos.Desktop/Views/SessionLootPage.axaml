<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Gw2Gizmos.Desktop.Controls"
             xmlns:core="using:Gw2Gizmos.Desktop.Core"
             x:Class="Gw2Gizmos.Desktop.Views.SessionLootPage"
             x:DataType="core:SessionLootViewModel">
    <c:PageShell Breadcrumbs="{Binding Breadcrumbs}">
        <StackPanel>
            <!-- Nothing changed during this segment -->
            <c:Card Margin="0,4,0,0" Padding="20" IsVisible="{Binding IsEmpty}">
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="No currency or item changes were recorded while this character was active. Account-wide gains are best-effort and depend on the Wallet/Materials/Bank/Characters features being enabled." />
            </c:Card>

            <!-- Currencies -->
            <StackPanel IsVisible="{Binding HasCurrencies}" Margin="0,4,0,0">
                <TextBlock Text="Currencies" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,6" />
                <ItemsControl ItemsSource="{Binding Currencies}" ItemTemplate="{StaticResource SessionCurrencyRowTemplate}" />
            </StackPanel>

            <!-- Items, with a gold-value / quantity sorter (asc/desc) -->
            <StackPanel IsVisible="{Binding ItemsSorter.HasItems}" Margin="0,12,0,0">
                <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="Items" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"
                               DockPanel.Dock="Left" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ComboBox ItemsSource="{Binding ItemsSorter.SortOptions}"
                                  SelectedIndex="{Binding ItemsSorter.SelectedSortIndex}"
                                  MinWidth="120" Height="{StaticResource FormControlHeight}" Margin="0,0,6,0" />
                        <Button Command="{Binding ItemsSorter.ToggleDirectionCommand}" Padding="9,0"
                                Height="{StaticResource FormControlHeight}" ToolTip.Tip="{Binding ItemsSorter.DirectionLabel}">
                            <Panel>
                                <c:FluentIcon Symbol="ArrowUp24" FontSize="16" IsVisible="{Binding ItemsSorter.Descending}" />
                                <c:FluentIcon Symbol="ArrowDown24" FontSize="16" IsVisible="{Binding !ItemsSorter.Descending}" />
                            </Panel>
                        </Button>
                    </StackPanel>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding ItemsSorter.View}" ItemTemplate="{StaticResource SessionItemRowTemplate}" />
            </StackPanel>

            <!-- Delete this character segment. Hidden on the active, still-tracked segment. -->
            <Button Content="Delete segment" Classes="danger" Margin="0,24,0,0" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" Height="{StaticResource FormControlHeight}"
                    Command="{Binding DeleteSegmentCommand}" IsVisible="{Binding CanDelete}" />
        </StackPanel>
    </c:PageShell>
</UserControl>
