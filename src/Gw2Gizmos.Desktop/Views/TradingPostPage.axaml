<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:c="using:Gw2Gizmos.Desktop.Controls"
             xmlns:core="using:Gw2Gizmos.Desktop.Core"
             xmlns:nav="using:Gw2Gizmos.Desktop.Core.Navigation"
             x:Class="Gw2Gizmos.Desktop.Views.TradingPostPage"
             x:DataType="core:TradingPostViewModel">
    <!-- The trading post's sections, each with a summary of what's in it; a row opens its page. -->
    <c:PageShell Title="Trading post">
        <StackPanel>
            <ui:FASettingsExpander Header="Orders" Description="{Binding OrdersSummary}" Margin="0,0,0,8"
                                   IconSource="{c:FluentIconSource BuildingShop24}" IsClickEnabled="True"
                                   ActionIconSource="ChevronRight" Command="{Binding OpenCommand}"
                                   CommandParameter="{x:Static nav:AppPage.TradingPostOrders}">
                <ui:FASettingsExpander.Footer>
                    <StackPanel IsVisible="{Binding HasAccount}" HorizontalAlignment="Right">
                        <c:CoinDisplay Copper="{Binding TiedUpCopper}" FontWeight="Medium" FontSize="13"
                                       HorizontalAlignment="Right" />
                        <TextBlock Text="tied up" FontSize="11" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ui:FASettingsExpander.Footer>
            </ui:FASettingsExpander>

            <ui:FASettingsExpander Header="History" Description="{Binding HistorySummary}" Margin="0,0,0,8"
                                   IconSource="{c:FluentIconSource History24}" IsClickEnabled="True"
                                   ActionIconSource="ChevronRight" Command="{Binding OpenCommand}"
                                   CommandParameter="{x:Static nav:AppPage.TradingPostHistory}">
                <ui:FASettingsExpander.Footer>
                    <StackPanel IsVisible="{Binding HasAccount}" HorizontalAlignment="Right">
                        <c:CoinDisplay Copper="{Binding HistoryNetCopper}" Signed="True" FontWeight="Medium"
                                       FontSize="13" HorizontalAlignment="Right" />
                        <TextBlock Text="net, last 30 days" FontSize="11" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ui:FASettingsExpander.Footer>
            </ui:FASettingsExpander>

            <ui:FASettingsExpander Header="Profit" Description="{Binding ProfitSummary}" Margin="0,0,0,8"
                                   IconSource="{c:FluentIconSource DataTrending24}" IsClickEnabled="True"
                                   ActionIconSource="ChevronRight" Command="{Binding OpenCommand}"
                                   CommandParameter="{x:Static nav:AppPage.TradingPostProfit}">
                <ui:FASettingsExpander.Footer>
                    <StackPanel IsVisible="{Binding HasAccount}" HorizontalAlignment="Right">
                        <c:CoinDisplay Copper="{Binding MonthProfitCopper}" Signed="True" FontWeight="Medium"
                                       FontSize="13" HorizontalAlignment="Right" />
                        <TextBlock Text="this month" FontSize="11" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ui:FASettingsExpander.Footer>
            </ui:FASettingsExpander>

            <ui:FASettingsExpander Header="Price alerts" Description="{Binding AlertsSummary}" Margin="0,0,0,8"
                                   IconSource="{c:FluentIconSource AlertOn24}" IsClickEnabled="True"
                                   ActionIconSource="ChevronRight" Command="{Binding OpenCommand}"
                                   CommandParameter="{x:Static nav:AppPage.PriceAlerts}" />
        </StackPanel>
    </c:PageShell>
</UserControl>
