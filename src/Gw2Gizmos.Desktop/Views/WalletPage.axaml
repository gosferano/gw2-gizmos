<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Gw2Gizmos.Desktop.Controls"
             xmlns:core="using:Gw2Gizmos.Desktop.Core"
             x:Class="Gw2Gizmos.Desktop.Views.WalletPage"
             x:DataType="core:WalletViewModel">
    <c:PageShell Breadcrumbs="{Binding Breadcrumbs}">
        <ItemsControl ItemsSource="{Binding Wallet}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="core:WalletRow">
                    <!-- Hover highlight so it's clear which amount belongs to which currency. -->
                    <Border Classes="hover-row">
                        <DockPanel>
                            <!-- Coin as g/s/c with coin icons; other currencies as a count. -->
                            <Panel DockPanel.Dock="Right" VerticalAlignment="Center">
                                <c:CoinDisplay Copper="{Binding Value}" FontWeight="Medium" HorizontalAlignment="Right"
                                               IsVisible="{Binding IsCoin}" />
                                <TextBlock FontWeight="Medium" HorizontalAlignment="Right" IsVisible="{Binding !IsCoin}"
                                           Text="{Binding Value, StringFormat='{}{0:N0}'}" />
                            </Panel>
                            <c:IconImage IconUrl="{Binding IconUrl}" Width="28" Height="28" Margin="0,0,10,0"
                                         VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </c:PageShell>
</UserControl>
