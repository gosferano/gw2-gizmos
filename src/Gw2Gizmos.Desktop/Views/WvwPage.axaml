<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Gw2Gizmos.Desktop.Controls"
             xmlns:core="using:Gw2Gizmos.Desktop.Core"
             x:Class="Gw2Gizmos.Desktop.Views.WvwPage"
             x:DataType="core:WvwViewModel">
    <UserControl.Styles>
        <!-- The three sides' colours, as a strip on each team card. -->
        <Style Selector="Border.team-strip.red">
            <Setter Property="Background" Value="#D9534F" />
        </Style>
        <Style Selector="Border.team-strip.blue">
            <Setter Property="Background" Value="#4A90D9" />
        </Style>
        <Style Selector="Border.team-strip.green">
            <Setter Property="Background" Value="#5CB85C" />
        </Style>
    </UserControl.Styles>

    <c:PageShell Title="WvW" Scrollable="False" MaxContentWidth="100000">
        <Grid RowDefinitions="Auto,*">
            <!-- What stands in for the matchup until there is one. -->
            <TextBlock Grid.Row="0" Margin="0,0,0,10" TextWrapping="Wrap" IsVisible="{Binding HasProblem}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Problem}" />
            <TextBlock Grid.Row="0" Margin="0,0,0,10" Text="Loading the matchup…" IsVisible="{Binding IsLoading}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <!-- The scoreboard: one card per team, then the skirmish under way. -->
            <Grid Grid.Row="0" ColumnDefinitions="*,*,*,Auto" Margin="0,0,0,10" IsVisible="{Binding HasMatchup}">
                <ItemsControl Grid.ColumnSpan="3" ItemsSource="{Binding Teams}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="core:WvwTeamStanding">
                            <Border Margin="0,0,8,0" CornerRadius="6" ClipToBounds="True"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Width="4" Classes="team-strip"
                                            Classes.red="{Binding IsRed}" Classes.blue="{Binding IsBlue}"
                                            Classes.green="{Binding IsGreen}" />
                                    <StackPanel Margin="12,8">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="Your team" IsVisible="{Binding IsYours}" FontSize="12"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                        </StackPanel>
                                        <TextBlock FontSize="22" FontWeight="SemiBold" Margin="0,2,0,0">
                                            <Run Text="{Binding VictoryPoints}" />
                                            <Run Text="VP" FontSize="12" FontWeight="Normal" />
                                        </TextBlock>
                                        <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                            <Run Text="{Binding SkirmishScore}" />
                                            <Run Text="skirmish ·" />
                                            <Run Text="{Binding PointsPerTick, StringFormat='+{0}'}" />
                                            <Run Text="per tick" />
                                        </TextBlock>
                                        <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                            <Run Text="{Binding Kills}" />
                                            <Run Text="kills ·" />
                                            <Run Text="{Binding Deaths}" />
                                            <Run Text="deaths" />
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Grid.Column="3" VerticalAlignment="Center" Margin="8,0,0,0" Text="{Binding SkirmishText}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Grid>

            <Border Grid.Row="1" CornerRadius="8" ClipToBounds="True">
                <Panel>
                    <c:MapView Continent="{Binding Continent}" CenterX="{Binding CenterX}" CenterY="{Binding CenterY}"
                               Zoom="{Binding Zoom}" MinZoom="{Binding MinZoom}" MaxZoom="{Binding MaxZoom}"
                               Landmarks="{Binding Landmarks}" Flight="{Binding Flight}" />

                    <!-- Zoom and home, over the map's bottom-right corner. -->
                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12" Padding="4"
                            CornerRadius="6" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="2">
                            <Button Theme="{StaticResource TransparentButton}" Padding="8" ToolTip.Tip="Zoom in"
                                    Command="{Binding ZoomInCommand}">
                                <c:FluentIcon Symbol="ZoomIn24" FontSize="16" />
                            </Button>
                            <Button Theme="{StaticResource TransparentButton}" Padding="8" ToolTip.Tip="Zoom out"
                                    Command="{Binding ZoomOutCommand}">
                                <c:FluentIcon Symbol="ZoomOut24" FontSize="16" />
                            </Button>
                            <Button Theme="{StaticResource TransparentButton}" Padding="8" ToolTip.Tip="Back to all maps"
                                    Command="{Binding HomeCommand}">
                                <c:FluentIcon Symbol="Home24" FontSize="16" />
                            </Button>
                        </StackPanel>
                    </Border>
                </Panel>
            </Border>
        </Grid>
    </c:PageShell>
</UserControl>
