<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:c="using:Gw2Gizmos.Desktop.Controls"
             xmlns:core="using:Gw2Gizmos.Desktop.Core"
             x:Class="Gw2Gizmos.Desktop.Views.CharacterPage"
             x:DataType="core:CharacterViewModel">
    <c:PageShell Breadcrumbs="{Binding Breadcrumbs}">
        <StackPanel>
            <!-- The character's card, then its sub-sections (currently just the bags). -->
            <c:Card Padding="12" Margin="0,0,0,8" IsVisible="{Binding Card, Converter={x:Static ObjectConverters.IsNotNull}}">
                <ContentControl Content="{Binding Card}" ContentTemplate="{StaticResource CharacterHeaderTemplate}" />
            </c:Card>
            <ui:FASettingsExpander Header="Inventory" Description="Items in this character's bags" Margin="0,0,0,8"
                                   IconSource="{c:FluentIconSource Backpack24}" IsClickEnabled="True"
                                   ActionIconSource="ChevronRight" Click="OnOpenInventory" />
        </StackPanel>
    </c:PageShell>
</UserControl>
