<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sty="using:FluentAvalonia.Styling"
             x:Class="Gw2Gizmos.Desktop.App"
             RequestedThemeVariant="Default">
    <!-- FluentAvalonia's Windows 11 look (follows the OS light/dark preference via the Default theme variant). It reads the
         OS accent itself on Windows, KDE, LXQt and LXDE (off by default, which left every OS on its SlateBlue fallback);
         elsewhere the platform's ISystemAccentColor supplies it (see App.FollowSystemAccentColor). -->
    <Application.Styles>
        <sty:FluentAvaloniaTheme PreferUserAccentColor="True" />
        <StyleInclude Source="/Themes/Styles.axaml" />
    </Application.Styles>

    <!-- The app's shared controls (page chrome, cards) and constants. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Themes/Controls.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <!-- Tray icon: the app lives here while its window is hidden (closing the window hides it). -->
    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="/Assets/gw2gizmos.png" ToolTipText="Gw2Gizmos" Clicked="OnTrayClicked">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Show Gw2Gizmos" Click="OnTrayShowClicked" />
                        <NativeMenuItem Header="Exit" Click="OnTrayExitClicked" />
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>
</Application>
