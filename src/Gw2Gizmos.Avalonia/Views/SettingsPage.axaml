<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:c="using:Gw2Gizmos.Avalonia.Controls"
             xmlns:core="using:Gw2Gizmos.Desktop.Core"
             x:Class="Gw2Gizmos.Avalonia.Views.SettingsPage"
             x:DataType="core:SettingsViewModel">
    <c:PageShell Title="Settings">
        <StackPanel>
            <!-- Launch at login; starts in the tray and spawns the worker. -->
            <c:Card Margin="0,0,0,14" Padding="16,12">
                <DockPanel>
                    <ToggleSwitch DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0"
                                  OnContent="" OffContent="" IsChecked="{Binding LaunchAtStartup}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Launch at login" FontWeight="Medium" FontSize="14"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock TextWrapping="Wrap" Margin="0,2,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Start Gw2Gizmos in the tray when you sign in (the background worker starts with it)." />
                    </StackPanel>
                </DockPanel>
            </c:Card>

            <TextBlock Margin="0,0,0,14" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="Turn the data the worker syncs on or off. A feature that's on but whose API key lacks the permission it needs is flagged here and in red on the API keys page." />

            <ItemsControl ItemsSource="{Binding Features}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="core:FeatureToggle">
                        <c:Card Margin="0,0,0,8" Padding="16,12">
                            <DockPanel>
                                <ToggleSwitch DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0"
                                              OnContent="" OffContent="" IsChecked="{Binding IsEnabled}" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Display}" FontWeight="Medium" FontSize="14"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,2,0,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding Permissions}" FontSize="12" Margin="0,3,0,0"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="{Binding Warning}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"
                                               Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                               IsVisible="{Binding HasWarning}" />
                                </StackPanel>
                            </DockPanel>
                        </c:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Advanced: per-sync intervals, behind a chevron card (with a "not recommended" warning inside). -->
            <ui:FASettingsExpander Header="Advanced" Description="Sync intervals" Margin="0,14,0,0"
                                   IconSource="{c:FluentIconSource Options24}" IsClickEnabled="True" ActionIconSource="ChevronRight"
                                   Click="OnOpenAdvanced" />

            <!-- Stored data: delete locally-stored data per type, per account (sub-page). -->
            <ui:FASettingsExpander Header="Stored data" Description="Delete locally-stored data per type, per account"
                                   Margin="0,8,0,0" IconSource="{c:FluentIconSource Delete24}" IsClickEnabled="True"
                                   ActionIconSource="ChevronRight" Click="OnOpenStoredData" />
        </StackPanel>
    </c:PageShell>
</UserControl>
