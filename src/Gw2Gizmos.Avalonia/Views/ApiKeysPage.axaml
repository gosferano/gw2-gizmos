<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:c="using:Gw2Gizmos.Avalonia.Controls"
             xmlns:core="using:Gw2Gizmos.Desktop.Core"
             x:Class="Gw2Gizmos.Avalonia.Views.ApiKeysPage"
             x:DataType="core:ApiKeysViewModel">
    <UserControl.Styles>
        <!-- Permission chips: granted ones read normally, an enabled feature's missing permission is red, the rest
             are dimmed (missing is declared last so it wins). -->
        <Style Selector="TextBlock.permission">
            <Setter Property="Opacity" Value="0.4" />
        </Style>
        <Style Selector="TextBlock.permission.present">
            <Setter Property="Opacity" Value="0.9" />
        </Style>
        <Style Selector="TextBlock.permission.missing">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
        </Style>
        <!-- The active account's check is accent-coloured; the others are faint. -->
        <Style Selector="ui|FASymbolIcon.select">
            <Setter Property="Opacity" Value="0.35" />
        </Style>
        <Style Selector="ui|FASymbolIcon.select.selected">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
        </Style>
    </UserControl.Styles>

    <c:PageShell Title="API keys" MaxContentWidth="640">
        <StackPanel>
            <TextBlock Text="GW2 API keys" FontWeight="Medium" />
            <TextBlock Text="Add one key per account. Create one at account.arena.net."
                       Opacity="0.7" Margin="0,2,0,8" TextWrapping="Wrap" />

            <Grid ColumnDefinitions="*,Auto">
                <TextBox Grid.Column="0" Text="{Binding ApiKeyInput}" PlaceholderText="paste key here"
                         FontFamily="{StaticResource MonospaceFontFamily}"
                         Height="{StaticResource FormControlHeight}" VerticalContentAlignment="Center" />
                <Button Grid.Column="1" Content="Add" Command="{Binding AddCommand}" Classes="accent"
                        Height="{StaticResource FormControlHeight}" Margin="8,0,0,0" />
            </Grid>
            <TextBlock Text="{Binding Status}" Opacity="0.8" Margin="0,6,0,0" TextWrapping="Wrap"
                       IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <ItemsControl ItemsSource="{Binding Keys}" Margin="0,14,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="core:ApiKeyCard">
                        <c:Card Margin="0,0,0,8" Padding="14,11">
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding AccountName}" FontWeight="Medium" FontSize="15" />
                                    <TextBlock Text="{Binding KeyName}" Opacity="0.7" Margin="0,1,0,0" />
                                    <!-- Every GW2 permission, marked granted and/or required-but-missing. -->
                                    <ItemsControl ItemsSource="{Binding Permissions}" Margin="0,6,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="core:PermissionChip">
                                                <Border Margin="0,0,6,5" Padding="7,2" CornerRadius="9"
                                                        Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                                    <TextBlock Classes="permission"
                                                               Classes.present="{Binding Present}"
                                                               Classes.missing="{Binding RequiredMissing}"
                                                               Text="{Binding Name}" FontSize="11" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <!-- Select: makes this the active account (radio-style). -->
                                <Button Grid.Column="1" VerticalAlignment="Center" Padding="8" Margin="10,0,0,0"
                                        Command="{Binding $parent[UserControl].((core:ApiKeysViewModel)DataContext).SelectAccountCommand}"
                                        CommandParameter="{Binding}" ToolTip.Tip="Use this account">
                                    <ui:FASymbolIcon Symbol="Accept" FontSize="18" Classes="select"
                                                     Classes.selected="{Binding IsSelected}" />
                                </Button>
                                <Button Grid.Column="2" VerticalAlignment="Center" Padding="8" Margin="6,0,0,0"
                                        Command="{Binding $parent[UserControl].((core:ApiKeysViewModel)DataContext).DeleteCommand}"
                                        CommandParameter="{Binding AccountId}" ToolTip.Tip="Remove this key">
                                    <ui:FASymbolIcon Symbol="Delete" FontSize="18" />
                                </Button>
                            </Grid>
                        </c:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </c:PageShell>
</UserControl>
