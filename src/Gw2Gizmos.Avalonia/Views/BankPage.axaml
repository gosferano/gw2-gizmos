<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Gw2Gizmos.Avalonia.Controls"
             xmlns:core="using:Gw2Gizmos.Desktop.Core"
             x:Class="Gw2Gizmos.Avalonia.Views.BankPage"
             x:DataType="core:BankViewModel">
    <c:PageShell Breadcrumbs="{Binding Breadcrumbs}">
        <!-- Ten square slots per row, capped in width so slots stay icon-sized on wide windows. -->
        <ItemsControl ItemsSource="{Binding Slots}" ItemTemplate="{StaticResource SlotTemplate}"
                      MaxWidth="720" HorizontalAlignment="Stretch" VerticalAlignment="Top">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="10" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
    </c:PageShell>
</UserControl>
