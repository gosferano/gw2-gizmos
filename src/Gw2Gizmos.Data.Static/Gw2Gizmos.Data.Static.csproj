<Project Sdk="Microsoft.NET.Sdk">

  <!-- Hardcoded reference data the GW2 API doesn't expose: world-boss / meta-event schedules (no timer
       endpoint exists), Mystic Forge recipes, vendor buy-prices, and the names of items achievements refer to that the
       API doesn't list. Pure data + models, no dependencies. -->

  <!-- Curated tables scraped from the wiki (see tools/Gw2Gizmos.Wiki.DataScraper), embedded so the engine can
       price vendor-bought items and Mystic-Forge intermediates that the API doesn't cover. -->
  <ItemGroup>
    <EmbeddedResource Include="Crafting\Data\*.json" />
    <EmbeddedResource Include="Crafting\Data\*.json.gz" />
    <EmbeddedResource Include="Achievements\Data\*.json.gz" />
  </ItemGroup>

</Project>
